# Local runtime output (avoid committing dev logs/cache created when running from repo root)
/data/
.parafork/
.worktree-lite/
/webui/dist/
/dist/updates/

# Local env
/server/.env
/server/.env.*
/server-go/.env
/server-go/.env.*

# Runtime data (private)
/server/data/
/server/cmd/server/data/
/server-go/data/
/server-go/cmd/server/data/

# Runtime logs / debug artifacts
/server/migration.log
/server/**/debug_*.log
/server-go/**/debug_*.log
/data/tmp/
/proxy/runtime/

# Server local build outputs
# server.exe 是 Windows 本地构建产物（go build ./cmd/server），仓库内无任何脚本引用：
# Docker 用镜像内 Linux 二进制，桌面端 sidecar 由 scripts/package-desktop.sh 现场编译。
# 历史上误提交了 10 份（累计约 394MB），故不再纳入版本控制。
/server/server.exe

# Proxy local build outputs
/proxy/pt-nexus-box-proxy
/proxy/pt-nexus-box-proxy-amd64
/proxy/pt-nexus-box-proxy-arm64
/proxy/pt-nexus-box-proxy-linux-amd64
/proxy/pt-nexus-box-proxy.exe

# Local IDE/agent private settings
/.claude/
/.codex/
/.github/
/.vscode/*
!/.vscode/extensions.json
*/__pycache__

# IDE project files (JetBrains)
/.idea/

# Release build staging (binaries + manifests generated during manual release)
/dist/

# WorkBuddy agent private workspace (skills / scratch / memory / diagnostics)
/.workbuddy/
